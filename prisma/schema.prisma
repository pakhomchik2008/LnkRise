// LnkRise — data model
//
// Deviations from the original spec, and why:
//   * DailyBrief.date / AnalyticsSnapshot.date are @db.Date, not DateTime.
//     The spec used `DateTime @default(now())` under a `@@unique([userId, date])`.
//     now() is a timestamp, so the constraint would have been unique per
//     microsecond — one user could get unlimited briefs for the same calendar
//     day. A DATE column makes "one brief per user per day" actually hold.
//   * User.role added here rather than in a later phase: adding an enum-ish
//     column later means a second migration over a populated table.
//   * VerificationToken added — the NextAuth Prisma adapter expects it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  role           String    @default("user") // user, admin

  linkedinUrl    String?
  linkedinData   Json? // profile data: fetched via OAuth, or entered by hand
  onboardingData Json? // questionnaire answers
  strategy       Json? // generated strategy
  connectionPlan Json? // the four outreach lanes; generated once, regenerated on request
  inspirations   String[] @default([]) // profile URLs the user admires

  growthScore    Int       @default(0)
  streak         Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveAt   DateTime?
  onboardedAt    DateTime?

  // preferences (Settings page)
  language          String  @default("en")
  timezone          String  @default("UTC")
  emailBriefEnabled Boolean @default(true)
  emailBriefHour    Int     @default(7) // local hour, 0-23
  postingFrequency  String  @default("3_per_week") // daily, 3_per_week, weekly
  contentTone       String  @default("professional") // professional, conversational, bold, storyteller
  dailyTimeBudget   Int     @default(30) // minutes per day

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?
  dailyBriefs  DailyBrief[]
  posts        Post[]
  analytics    AnalyticsSnapshot[]
  tasks        CoachingTask[]
  accounts     Account[]
  sessions     Session[]
  apiKeys      ApiKey[]
  aiUsage      AiUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripePriceId        String?
  stripeSubscriptionId String?   @unique
  status               String    @default("trialing") // trialing, active, canceled, past_due, expired
  plan                 String    @default("trial") // trial, starter, pro
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyBrief {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date // calendar day, normalised to UTC midnight
  content   Json // { todayFocus, postIdea, connectWith, commentOn, optimizationTip }
  completed Json     @default("{}")
  score     Int?
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks CoachingTask[]

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

/// Per-day AI generation counter, enforcing PLAN_ACCESS.aiGenerationsPerDay.
/// A row per user per calendar day rather than a running total, so the limit
/// resets without a cleanup job. Same @db.Date + composite-unique shape as
/// DailyBrief, for the same reason: a plain DateTime would make "today"
/// unique per microsecond and every increment would insert a new row.
model AiUsage {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  generations Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

model Post {
  id          String    @id @default(cuid())
  userId      String
  title       String?
  content     String    @db.Text
  status      String    @default("draft") // draft, scheduled, published
  scheduledAt DateTime?
  publishedAt DateTime?
  aiGenerated Boolean   @default(false)
  /// Set once published through the official API — the post's URN on the
  /// platform, used to pull per-post analytics back.
  linkedinUrn String?   @unique
  metrics     Json? // { views, likes, comments, shares }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AnalyticsSnapshot {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date
  profileViews      Int      @default(0)
  postImpressions   Int      @default(0)
  followers         Int      @default(0)
  connections       Int      @default(0)
  searchAppearances Int      @default(0)
  engagementRate    Float    @default(0)
  source            String   @default("manual") // manual, api, extension, metricool
  rawData           Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

model CoachingTask {
  id          String    @id @default(cuid())
  userId      String
  briefId     String?
  type        String // post, connect, comment, optimize, engage
  title       String
  description String?   @db.Text
  priority    String    @default("medium") // high, medium, low
  status      String    @default("pending") // pending, completed, skipped
  dueDate     DateTime?
  completedAt DateTime?
  aiData      Json?
  createdAt   DateTime  @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  brief DailyBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([briefId])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  author      String    @default("LnkRise Team")
  tags        String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  userName    String
  userImage   String?
  userRole    String?
  beforeStats Json
  afterStats  Json
  story       String   @db.Text
  testimonial String?  @db.Text
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

/// Pairs the browser extension to an account. The raw key is shown once at
/// creation and never stored — only its SHA-256 hash, so a database leak does
/// not hand out working ingest credentials.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  label      String    @default("Browser extension")
  /// First 8 chars of the raw key, for display. Not a secret.
  prefix     String
  hashedKey  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
