# ---------------------------------------------------------------------------
# LnkRise environment variables
#
# Everything below is OPTIONAL in development. The app detects missing keys and
# falls back to a deterministic mock layer (mock AI, dev credentials sign-in).
# Fill these in to switch a subsystem from mock to real — no code changes.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local:      postgresql://USER@localhost:5432/lnkrise
# Neon:       postgresql://USER:PASS@ep-xxx.eu-central-1.aws.neon.tech/lnkrise?sslmode=require
DATABASE_URL=

# --- Auth (required) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- OAuth providers (optional — hidden from the UI when unset) ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Official Community Management API (see docs/DATA-SOURCES.md) ---------
# Leave unset until LinkedIn approves the app for r_member_postAnalytics and
# w_member_social. Setting it early makes sign-in itself fail: LinkedIn rejects
# the whole authorization request when an app asks for an unapproved scope.
#   enabled  -> request analytics + posting scopes, allow pull and publish
#   (unset)  -> OpenID sign-in only; extension and manual entry still work
LINKEDIN_COMMUNITY_API=
# Versioned API month, YYYYMM. Defaults to 202606.
LINKEDIN_API_VERSION=

# --- AI (optional — mock engine is used when unset) -----------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Payments (optional — /billing shows plans with checkout disabled when unset) --
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard — Starter is a one-time price, Pro a recurring one.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Email (optional — emails are logged to the console when unset) ------
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend once the key is set.
EMAIL_FROM=

# --- Cron (required for the daily brief job) -------------------------------
# Protects /api/cron/daily-brief, which generates briefs and sends mail — an
# open endpoint would let anyone burn the AI budget and spam users. The route
# returns 503 while this is unset rather than running unauthenticated.
# Vercel sends it automatically as "Authorization: Bearer $CRON_SECRET".
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
